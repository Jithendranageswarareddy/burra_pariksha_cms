# ==============================================================================
# BURRA PARIKSHA CMS (BP-CMS) — AUTHORITATIVE ENVIRONMENT CONFIGURATION
# ==============================================================================
# File: .env.example
# Purpose: Authoritative template for Google AI Studio Secrets Panel & production runtimes.
#
# INSTRUCTIONS:
# 1. In Google AI Studio: Enter each secret below into the Applet Secrets panel.
# 2. In Local Development: Copy this file to '.env.local' and populate with local credentials.
#
# SECURITY RULES:
# - NEVER commit real credentials to GitHub.
# - '.env.local' is gitignored and must remain local-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME & NETWORKING (Optional Overrides)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# ------------------------------------------------------------------------------
# 2. CANONICAL PRODUCTION SECRETS (Required by Google AI Studio)
# ------------------------------------------------------------------------------

# 1. Core Authentication Session Secret (HMAC-SHA256 signature key)
# Secret: YES | Required: YES in production
SESSION_SECRET="<generate-secure-64-character-random-hex-or-base64-string>"

# 2. Firebase Admin SDK / GCP Service Account Email
# Secret: NO | Required: YES (or via ambient GCP Application Default Credentials)
GOOGLE_SERVICE_ACCOUNT_EMAIL="<service-account@project-id.iam.gserviceaccount.com>"

# 3. Firebase Admin SDK / GCP Service Account RSA Private Key (PEM format)
# Secret: YES | Required: YES (or via ambient GCP Application Default Credentials)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<service-account-private-key>\n-----END PRIVATE KEY-----\n"

# 4. Google Gemini API Key (AI Question Studio, scripting, and multi-layer verification)
# Secret: YES | Required: YES for AI capabilities
GEMINI_API_KEY="<your-google-gemini-api-key>"

# 5. Google Drive Root Folder ID (Takes, thumbnails, and master cut video binaries)
# Secret: NO | Required: YES for Google Drive file storage
GOOGLE_DRIVE_ROOT_FOLDER_ID="<google-drive-root-folder-id>"

# 6. Google Cloud OAuth 2.0 Client ID (Drive delegation)
# Secret: NO | Required: YES for Google Drive upload mode
GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"

# 7. Google Cloud OAuth 2.0 Client Secret (Drive delegation)
# Secret: YES | Required: YES for Google Drive upload mode
GOOGLE_CLIENT_SECRET="<your-google-oauth-client-secret>"

# 8. Google Drive OAuth 2.0 Refresh Token (Persistent offline Drive API delegation)
# Secret: YES | Required: YES for Google Drive upload mode
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN="<your-google-drive-oauth-refresh-token>"
