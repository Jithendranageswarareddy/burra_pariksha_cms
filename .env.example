# ==============================================================================
# BURRA PARIKSHA CMS (BP-CMS) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' (or '.env.local') to configure your local runtime.
# Fill in your real API keys, credentials, and identifiers where indicated.
#
# IMPORTANT: NEVER COMMIT THE REAL '.env' FILE OR ANY CREDENTIALS TO GITHUB.
# All real secrets must remain local-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & RUNTIME NETWORKING
# ------------------------------------------------------------------------------

# Port number for the full-stack Express + Vite application server.
# Secret: NO
# Required: OPTIONAL (Defaults to 3000 if unset)
# Format: Positive integer (e.g. 3000, 8080)
PORT="3000"

# Host interface to bind the application server.
# Secret: NO
# Required: OPTIONAL (Defaults to 0.0.0.0 if unset)
# Format: IP address string (e.g. 0.0.0.0 for all interfaces, 127.0.0.1 for localhost)
HOST="0.0.0.0"

# Application runtime environment mode.
# Secret: NO
# Required: OPTIONAL (Defaults to development mode)
# Format: 'development' or 'production'
NODE_ENV="development"


# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------

# Secret key used for signing and verifying HMAC-SHA256 session tokens (bp_session cookies).
# Secret: YES
# Required: YES in production (Falls back to insecure dev key in local development)
# Where to obtain: Generate a strong, random 64-character hex or base64 string.
# IMPORTANT: NEVER COMMIT THE REAL VALUE TO GITHUB.
SESSION_SECRET="REPLACE_WITH_YOUR_RANDOM_SESSION_SECRET"

# Initial password assigned to the default Administrator account (USR-001) during first bootstrap.
# Secret: YES
# Required: OPTIONAL (Defaults to password123 if unset during initial setup)
# Where to obtain: Define your desired master admin password.
# IMPORTANT: NEVER COMMIT THE REAL VALUE TO GITHUB.
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_YOUR_INITIAL_ADMIN_PASSWORD"

# Secret token required to authorize remote spreadsheet initialization via POST /api/sheets/initialize.
# Secret: YES
# Required: YES when executing the /api/sheets/initialize endpoint.
# Where to obtain: Choose an arbitrary, secure token string known only to operators.
# IMPORTANT: NEVER COMMIT THE REAL VALUE TO GITHUB.
BOOTSTRAP_SECRET="REPLACE_WITH_YOUR_BOOTSTRAP_SECRET"


# ------------------------------------------------------------------------------
# 3. GOOGLE SHEETS PRIMARY DATABASE
# ------------------------------------------------------------------------------

# The Google Sheets Spreadsheet ID representing the primary 25-tab BP-CMS datastore.
# Secret: NO
# Required: YES for live database read/write operations.
# Where to obtain: From the Google Sheets URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
# Format: Alphanumeric string (typically 44 characters)
GOOGLE_SHEETS_ID="REPLACE_WITH_YOUR_GOOGLE_SHEETS_ID"

# Google Cloud Service Account email address with 'Editor' permissions on the Google Sheet.
# Secret: NO
# Required: YES for Sheets and Drive Service Account authentication.
# Where to obtain: Google Cloud Console -> IAM & Admin -> Service Accounts (e.g., service-account-name@project-id.iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL="REPLACE_WITH_YOUR_GOOGLE_SERVICE_ACCOUNT_EMAIL"

# Google Cloud Service Account RSA Private Key (PEM format).
# Secret: YES
# Required: YES for Sheets and Drive Service Account authentication.
# Where to obtain: Downloaded JSON key file from Google Cloud Console Service Account keys -> "private_key" field.
# Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n" (keep literal \n linebreaks or multi-line PEM)
# IMPORTANT: NEVER COMMIT THE REAL VALUE TO GITHUB.
GOOGLE_PRIVATE_KEY="REPLACE_WITH_YOUR_GOOGLE_PRIVATE_KEY"


# ------------------------------------------------------------------------------
# 4. ISOLATED SOCIAL ANALYTICS WORKBOOK
# ------------------------------------------------------------------------------

# Dedicated Google Sheets Spreadsheet ID used exclusively for audience retention telemetry, comments, and analytics.
# Secret: NO
# Required: OPTIONAL (If unset, analytics operations fail safely without affecting the primary sheet)
# Where to obtain: Create a dedicated Google Sheet, share with Service Account email, copy ID from URL.
# Format: Alphanumeric string (typically 44 characters)
ANALYTICS_SPREADSHEET_ID="REPLACE_WITH_YOUR_ANALYTICS_SPREADSHEET_ID"


# ------------------------------------------------------------------------------
# 5. GOOGLE DRIVE MEDIA INFRASTRUCTURE
# ------------------------------------------------------------------------------

# Google Drive folder ID where uploaded takes, master cuts, and thumbnails are stored.
# Secret: NO
# Required: YES for Google Drive file uploads.
# Where to obtain: Open target folder in Google Drive, copy ID from URL: https://drive.google.com/drive/folders/<FOLDER_ID>
# Format: Alphanumeric folder ID
GOOGLE_DRIVE_ROOT_FOLDER_ID="REPLACE_WITH_YOUR_GOOGLE_DRIVE_ROOT_FOLDER_ID"

# Google Cloud OAuth 2.0 Client ID for Drive user delegation.
# Secret: NO
# Required: YES when using OAuth2 Drive authorization mode.
# Where to obtain: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
GOOGLE_CLIENT_ID="REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID"

# Google Cloud OAuth 2.0 Client Secret.
# Secret: YES
# Required: YES when using OAuth2 Drive authorization mode.
# Where to obtain: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Client Secret.
# IMPORTANT: NEVER COMMIT THE REAL VALUE TO GITHUB.
GOOGLE_CLIENT_SECRET="REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET"

# Google OAuth 2.0 callback URL registered in Google Cloud Console.
# Secret: NO
# Required: OPTIONAL (Defaults to http://localhost:3000/api/auth/google/callback)
# Format: Absolute URL matching registered redirect URI.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Persistent Google Drive OAuth 2.0 Refresh Token obtained via user consent.
# Secret: YES
# Required: YES for live Google Drive uploads when operating in OAuth mode.
# Where to obtain: Acquired automatically via the /api/auth/google/url authorization flow, or via OAuth Playground.
# IMPORTANT: NEVER COMMIT THE REAL VALUE TO GITHUB.
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN="REPLACE_WITH_YOUR_GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN"


# ------------------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE (GOOGLE GEMINI)
# ------------------------------------------------------------------------------

# Google Gemini API key used for assistive question generation, script hooks, and content analysis.
# Secret: YES
# Required: YES when AI assistive capabilities are used.
# Where to obtain: Google AI Studio (https://aistudio.google.com/app/apikey) -> Create API key.
# IMPORTANT: NEVER COMMIT THE REAL VALUE TO GITHUB.
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"

# The Gemini model identifier used for inference tasks.
# Secret: NO
# Required: OPTIONAL (Defaults to 'gemini-2.5-flash' in GeminiClient if unset)
# Format: Model name string (e.g. gemini-2.5-flash, gemini-1.5-pro)
GEMINI_MODEL="gemini-2.5-flash"


# ------------------------------------------------------------------------------
# 7. DISASTER RECOVERY & SNAPSHOT ARCHIVE (GCS - OPTIONAL)
# ------------------------------------------------------------------------------

# Google Cloud Storage bucket name for immutable snapshot backups.
# Secret: NO
# Required: OPTIONAL (Only required if durable cloud backup archive is enabled)
# Format: Standard GCS bucket name (3–63 chars, lowercase alphanumeric, dots, hyphens)
GCS_SNAPSHOT_BUCKET="REPLACE_WITH_YOUR_GCS_SNAPSHOT_BUCKET"

# Toggle whether durable snapshot archiving to GCS is enabled.
# Secret: NO
# Required: OPTIONAL (Defaults to false if unset)
# Format: 'true' or 'false'
GCS_SNAPSHOT_ENABLED="false"

# Retention duration in days for durable GCS snapshot archives.
# Secret: NO
# Required: OPTIONAL (Defaults to 365 days if unset)
# Format: Positive integer
GCS_SNAPSHOT_RETENTION_DAYS="365"

# Toggle whether automated periodic snapshot backups run in the background.
# Secret: NO
# Required: OPTIONAL (Defaults to false if unset)
# Format: 'true' or 'false'
GCS_SNAPSHOT_SCHEDULE_ENABLED="false"


# ------------------------------------------------------------------------------
# 8. DEVELOPMENT & OFFLINE TESTING TOGGLES (OPTIONAL)
# ------------------------------------------------------------------------------

# Bypass live Google Sheets API sync (useful for local UI work without cloud access).
# Secret: NO
# Required: OPTIONAL (Defaults to false)
# Format: 'true' or 'false'
SKIP_SHEETS_SYNC="false"

# Bypass live Google Drive media sync.
# Secret: NO
# Required: OPTIONAL (Defaults to false)
# Format: 'true' or 'false'
SKIP_DRIVE_SYNC="false"

# Maximum allowed file size in bytes for thumbnail uploads.
# Secret: NO
# Required: OPTIONAL (Defaults to 5242880 = 5 MB)
MAX_THUMBNAIL_SIZE_BYTES="5242880"

# Maximum allowed file size in bytes for video take/master cut uploads.
# Secret: NO
# Required: OPTIONAL (Defaults to 104857600 = 100 MB, up to 524288000 = 500 MB)
MAX_VIDEO_SIZE_BYTES="104857600"

# ------------------------------------------------------------------------------
# 11. S2-T05 GOLDEN PATH TEST CREDENTIALS
# ------------------------------------------------------------------------------

# Test credentials used exclusively for automated Golden Path verification.
# Never configure production credentials here.
# Secret: YES
# Required: OPTIONAL (Required only when running tests/s2-t05-golden-path.test.ts)
S2_T05_CREATOR_EMAIL="REPLACE_WITH_TEST_CREATOR_EMAIL"
S2_T05_CREATOR_PASSWORD="REPLACE_WITH_TEST_CREATOR_PASSWORD"
S2_T05_REVIEWER_EMAIL="REPLACE_WITH_TEST_REVIEWER_EMAIL"
S2_T05_REVIEWER_PASSWORD="REPLACE_WITH_TEST_REVIEWER_PASSWORD"

# ------------------------------------------------------------------------------
# 12. FIREBASE / CLOUD FIRESTORE PRODUCTION CONFIGURATION (SPRINT 4)
# ------------------------------------------------------------------------------
# Firebase Project ID and Cloud Firestore Database ID.
# Client configuration is loaded automatically from firebase-applet-config.json.
# Secret: NO
# Required: MANDATORY in production
FIREBASE_PROJECT_ID="burra-pariksha-cms"
FIRESTORE_DATABASE_ID="ai-studio-burraparikshacon-f592ca42-39af-4d83-aff2-6870ba939b0e"
DATASTORE_PROVIDER="FIRESTORE"
