# ==========================================
# BURRA PARIKSHA CMS - Environment Configuration
# Phase 2: Google Sheets Database Architecture & Persistence
# ==========================================

# Required Application & Security Configuration
NODE_ENV="production"
PORT="3000"
SESSION_SECRET=""
BOOTSTRAP_SECRET=""
INITIAL_ADMIN_PASSWORD=""

# Required Google Sheets Database Credentials (Server-Side Only)
# Note: Google Sheets is the sole authoritative database store.
# These credentials are NEVER exposed to the browser.
GOOGLE_SHEETS_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Application Host URL
APP_URL="http://localhost:3000"

# Gemini AI Configuration (Server-Side Only)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# Durable Snapshot Archive Configuration (GCS - Server-Side Only)
# Optional configuration for Google Cloud Storage disaster recovery backups
GCS_SNAPSHOT_BUCKET=""
GCS_SNAPSHOT_ENABLED="false"
GCS_SNAPSHOT_RETENTION_DAYS="365"


