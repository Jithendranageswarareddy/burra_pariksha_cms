{
  "name": "burra-pariksha-cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test:unit": "tsx src/tests/stage01-draft-workflow-separation.test.ts && tsx src/tests/stage02-video-transitions.test.ts",
    "test:regression": "tsx src/tests/stage01-draft-workflow-separation.test.ts && tsx src/tests/stage02-video-transitions.test.ts",
    "test:workflow": "tsx src/tests/phase06-question-workflow-verification.ts",
    "test:publishing": "tsx src/tests/phase09-publishing-workflow-verification.ts",
    "test:all": "npm run test:unit",
    "test:phase03": "tsx src/tests/phase03-design-system-verification.ts",
    "test:phase04": "tsx src/tests/phase04-shell-navigation-verification.ts",
    "test:phase05": "tsx src/tests/phase05-dashboard-home-verification.ts",
    "test:phase06": "tsx src/tests/phase06-question-workflow-verification.ts",
    "test:phase07": "tsx src/tests/phase07-video-workflow-verification.ts",
    "test:phase08": "tsx src/tests/phase08-asset-review-verification.ts",
    "test:phase09": "tsx src/tests/phase09-publishing-workflow-verification.ts",
    "test:phase10": "tsx src/tests/phase10-analytics-experience-verification.ts",
    "test:phase11": "tsx src/tests/phase11-legacy-ui-simplification-verification.ts",
    "test:phase12": "tsx src/tests/phase12-final-ui-ux-acceptance-verification.ts",
    "test:phase14": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase14-only.ts",
