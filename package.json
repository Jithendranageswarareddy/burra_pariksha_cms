    "test:phase16": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase16-only.ts",
    "test:phase17": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase17-only.ts",
    "test:phase18": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase18-only.ts",
    "test:phase19": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase19-only.ts",
    "test:phase20": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase20-only.ts",
    "test:phase21": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase21-only.ts",
    "test:phase22": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase22-only.ts",
    "test:phase23": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase23-only.ts",
    "test:phase24": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase24-only.ts",
    "test:phase25": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase25-only.ts",
    "test:phase26": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase26-only.ts",
    "test:phase27": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase27-only.ts",
    "test:phase28": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase28-only.ts",
    "test:phase29": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase29.ts",
    "test:phase30": "SKIP_SHEETS_SYNC=true tsx src/tests/run-phase30-social-comments.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
