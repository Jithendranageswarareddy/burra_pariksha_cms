{
  "name": "burra-pariksha-cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "env:check": "tsx scripts/check-env.ts",
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "node --max-old-space-size=4096 ./node_modules/typescript/bin/tsc --noEmit",
    "test": "tsx tests/fc-001-auth.test.ts && tsx tests/fc-002-rbac.test.ts && tsx tests/fc-003-db-api.test.ts && tsx tests/fc-004-audit.test.ts && tsx tests/fc-005-workflow.test.ts",
    "test:auth": "tsx tests/fc-001-auth.test.ts",
    "test:rbac": "tsx tests/fc-002-rbac.test.ts",
    "test:db-api": "tsx tests/fc-003-db-api.test.ts",
    "test:audit": "tsx tests/fc-004-audit.test.ts",
    "test:workflow": "tsx tests/fc-005-workflow.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^176.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
