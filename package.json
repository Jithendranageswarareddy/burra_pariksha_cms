{
  "name": "burra-pariksha-cms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test:unit": "tsx src/tests/draft-workflow-separation.test.ts && tsx src/tests/video-transitions.test.ts",
    "test:regression": "tsx src/tests/draft-workflow-separation.test.ts && tsx src/tests/video-transitions.test.ts && tsx src/tests/targeted-bugfixes.test.ts",
    "test:workflow": "tsx src/tests/step01-question-studio-workflow-state.test.ts",
    "test:publishing": "tsx src/tests/publishing-workflow.test.ts",
    "test:stage02": "tsx src/tests/stage02-business-acceptance.test.ts",
    "test:stage03": "tsx src/tests/stage03-current-system-baseline.test.ts",
    "test:stage04": "tsx src/tests/stage04-architecture-principles.test.ts",
    "test:architecture": "tsx src/tests/stage04-architecture-principles.test.ts",
    "test:stage05": "tsx src/tests/stage05-system-boundary.test.ts",
    "test:stage06": "tsx src/tests/stage06-domain-model.test.ts",
    "test:stage07": "tsx src/tests/stage07-canonical-workflow.test.ts",
    "test:stage08": "tsx src/tests/stage08-state-model.test.ts",
    "test:stage09": "tsx src/tests/stage09-rbac-model.test.ts",
    "test:stage10": "tsx src/tests/stage10-frontend-ia.test.ts",
    "test:stage11": "tsx src/tests/stage11-page-route-contract.test.ts",
    "test:stage12": "tsx src/tests/stage12-database-decision.test.ts",
    "test:stage13": "tsx src/tests/stage13-data-contract.test.ts",
    "test:all": "npm run test:unit && npm run test:workflow && npm run test:publishing",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "busboy": "^1.6.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "googleapis": "^176.0.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
