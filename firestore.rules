rules_version = '2';

/**
 * BURRA PARIKSHA CMS — Cloud Firestore Security Rules
 * Architecture: OPTION A — BACKEND-ONLY AUTHORITATIVE GATEWAY
 *
 * Security Model:
 * 1. DIRECT BROWSER / UNAUTHENTICATED CLIENTS:
 *    - All transactional writes to production collections are STRICTLY DENIED.
 *    - No unauthenticated writes to users, questions, videos, assignments,
 *      publishing_packages, workflow_instances, social_analytics, etc.
 * 2. AUTHORITATIVE BACKEND GATEWAY:
 *    - BP-CMS Express server authenticates with custom backend service token
 *      (uid == 'backend-service' or role == 'BACKEND_SERVICE').
 *    - The backend enforces human-in-the-loop gates (AP-009) and segregation of duties (GAR-02).
 * 3. STRICT IMMUTABILITY GUARDS:
 *    - audit_logs, audit_events, and workflow_history are strictly write-once:
 *      Create is allowed by the backend, UPDATE AND DELETE ARE ABSOLUTELY FORBIDDEN.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isBackendGateway() {
      return request.auth != null && (
        request.auth.uid == 'backend-service' ||
        request.auth.token.role == 'BACKEND_SERVICE' ||
        request.auth.token.isBackend == true
      );
    }

    // 1. Immutable Collections (Audit Logs, Audit Events, Workflow History)
    // Write-once append-only ledger: create allowed, update/delete strictly forbidden!
    match /audit_logs/{logId} {
      allow read, create: if isBackendGateway();
      allow update, delete: if false;
    }

    match /audit_log/{logId} {
      allow read: if isBackendGateway();
      allow create: if isBackendGateway();
      allow update, delete: if false;
    }

    match /audit_events/{eventId} {
      allow read: if isBackendGateway();
      allow create: if isBackendGateway();
      allow update, delete: if false;
    }

    match /workflow_history/{historyId} {
      allow read: if isBackendGateway();
      allow create: if isBackendGateway();
      allow update, delete: if false;
    }

    // 2. Transactional Business Collections
    // Write access granted ONLY to authoritative backend gateway.
    // Direct unauthenticated browser/client writes are strictly DENIED.
    match /users/{userId} {
      allow read, write: if isBackendGateway();
    }

    match /questions/{questionId} {
      allow read, write: if isBackendGateway();
    }

    match /question_drafts/{draftId} {
      allow read, write: if isBackendGateway();
    }

    match /question_videos/{qvId} {
      allow read, write: if isBackendGateway();
    }

    match /videos/{videoId} {
      allow read, write: if isBackendGateway();
    }

    match /scripts/{scriptId} {
      allow read, write: if isBackendGateway();
    }

    match /script_versions/{verId} {
      allow read, write: if isBackendGateway();
    }

    match /thumbnails/{thumbId} {
      allow read, write: if isBackendGateway();
    }

    match /thumbnail_versions/{verId} {
      allow read, write: if isBackendGateway();
    }

    match /pinned_comments/{pinId} {
      allow read, write: if isBackendGateway();
    }

    match /pinned_comment_versions/{verId} {
      allow read, write: if isBackendGateway();
    }

    match /assignments/{assignmentId} {
      allow read, write: if isBackendGateway();
    }

    match /publishing_packages/{packageId} {
      allow read, write: if isBackendGateway();
    }

    match /workflow_instances/{workflowId} {
      allow read, write: if isBackendGateway();
    }

    match /workflow/{wId} {
      allow read, write: if isBackendGateway();
    }

    match /social_analytics/{analyticsId} {
      allow read, write: if isBackendGateway();
    }

    match /content_masters/{contentMasterId} {
      allow read, write: if isBackendGateway();
    }

    match /content_plans/{planId} {
      allow read, write: if isBackendGateway();
    }

    match /content_batches/{batchId} {
      allow read, write: if isBackendGateway();
    }

    match /question_validations/{valId} {
      allow read, write: if isBackendGateway();
    }

    match /social_reviews/{reviewId} {
      allow read, write: if isBackendGateway();
    }

    match /question_configs/{cfgId} {
      allow read, write: if isBackendGateway();
    }

    match /question_config/{cfgId} {
      allow read, write: if isBackendGateway();
    }

    match /media_assets/{assetId} {
      allow read, write: if isBackendGateway();
    }

    match /categories/{catId} {
      allow read, write: if isBackendGateway();
    }

    match /topics/{topicId} {
      allow read, write: if isBackendGateway();
    }

    match /subtopics/{subId} {
      allow read, write: if isBackendGateway();
    }

    match /sequences/{seqId} {
      allow read, write: if isBackendGateway();
    }

    match /analytics_intelligences/{intelId} {
      allow read, write: if isBackendGateway();
    }

    match /strategy_recommendations/{recId} {
      allow read, write: if isBackendGateway();
    }

    match /social_comments/{cmtId} {
      allow read, write: if isBackendGateway();
    }

    match /comment_intelligences/{cmiId} {
      allow read, write: if isBackendGateway();
    }

    // 3. Test Collections (Backend gateway only)
    match /test_backend/{docId} {
      allow read, write: if isBackendGateway();
    }

    match /test_questions/{docId} {
      allow read, write: if isBackendGateway();
    }

    // 4. Default Deny Catch-all for any other collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
