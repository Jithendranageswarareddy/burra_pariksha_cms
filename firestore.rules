rules_version = '2';

/**
 * BURRA PARIKSHA CMS — Cloud Firestore Security Rules
 * Sprint 4: Production Data Layer Migration
 *
 * Implements defensive document-level authorization rules:
 * - Default-deny catch-all
 * - AP-004: Server-Side Authoritative Gatekeeper
 * - GAR-02: Anti-Self-Approval Segregation-of-Duties
 * - Immutable append-only audit ledger
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function getUserToken() {
      return request.auth.token;
    }

    function hasRole(role) {
      return isAuthenticated() && (
        getUserToken().role == role ||
        role in getUserToken().roles
      );
    }

    function isAdmin() {
      return hasRole('ADMIN');
    }

    function isContentLead() {
      return hasRole('CONTENT_LEAD') || hasRole('CONTENT_MANAGER');
    }

    function isPublishingLead() {
      return hasRole('PUBLISHING_LEAD') || hasRole('PUBLISHING_MANAGER');
    }

    function isQaReviewer() {
      return hasRole('QA_REVIEWER') || hasRole('REVIEWER');
    }

    function isAuthor(docData) {
      return isAuthenticated() && (
        docData.authorId == request.auth.uid ||
        docData.createdBy == request.auth.uid
      );
    }

    function isAssignee(docData) {
      return isAuthenticated() && (
        docData.assigneeId == request.auth.uid
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Question Drafts
    match /question_drafts/{draftId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isContentLead() ||
        isQaReviewer() ||
        isAuthor(resource.data)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.authorId == request.auth.uid || isAdmin()
      );
      allow update: if isAuthenticated() && (
        (isAuthor(resource.data) && resource.data.status == 'DRAFT') ||
        (isQaReviewer() && !isAuthor(resource.data)) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Production Questions
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isContentLead();
    }

    // Assignments
    match /assignments/{assignmentId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isContentLead() ||
        isAssignee(resource.data)
      );
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isContentLead() ||
        isAssignee(resource.data)
      );
      allow create, delete: if isAdmin() || isContentLead();
    }

    // Audit Logs (Immutable Append-Only Ledger)
    match /audit_logs/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // Videos
    match /videos/{videoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isContentLead() || hasRole('VIDEO_EDITOR') || hasRole('PRESENTER');
    }

    // Content Masters
    match /content_masters/{contentMasterId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isContentLead();
    }

    // Publishing Packages
    match /publishing_packages/{packageId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || isPublishingLead();
    }

    // Social Analytics
    match /social_analytics/{analyticsId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || hasRole('ANALYST');
    }

    // Workflow Instances
    match /workflow_instances/{workflowId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Workflow History (Immutable Append-Only)
    match /workflow_history/{historyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
