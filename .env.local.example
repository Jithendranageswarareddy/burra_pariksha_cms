# ==============================================================================
# BURRA PARIKSHA CMS (BP-CMS) — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# File: .env.local.example
# Purpose: Authoritative template for local development configuration in Antigravity.
#
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' in the repository root:
#    cp .env.local.example .env.local
# 2. Populate '.env.local' with your credentials from Google AI Studio or GCP Console.
#
# SECURITY RULES:
# - NEVER commit '.env.local' to GitHub (protected by .gitignore).
# - NEVER share or expose real secret keys, tokens, or passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME NETWORKING & LOGGING (Local Defaults)
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# 2. CANONICAL PRODUCTION SECRETS (Required for full local feature parity)
# ------------------------------------------------------------------------------

# 1. Authentication Session Secret (HMAC-SHA256 signature key)
SESSION_SECRET="<generate-secure-64-character-random-hex-or-base64-string>"

# 2. Firebase Admin SDK / GCP Service Account Email
GOOGLE_SERVICE_ACCOUNT_EMAIL="<service-account@project-id.iam.gserviceaccount.com>"

# 3. Firebase Admin SDK / GCP Service Account RSA Private Key (PEM format)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<service-account-private-key>\n-----END PRIVATE KEY-----\n"

# 4. Google Gemini API Key (AI Question Studio, scripting, and verification)
GEMINI_API_KEY="<your-google-gemini-api-key>"

# 5. Google Drive Root Folder ID (Video takes and thumbnail media assets)
GOOGLE_DRIVE_ROOT_FOLDER_ID="<google-drive-root-folder-id>"

# 6. Google Cloud OAuth 2.0 Client ID (Drive delegation)
GOOGLE_CLIENT_ID="<client-id>.apps.googleusercontent.com"

# 7. Google Cloud OAuth 2.0 Client Secret (Drive delegation)
GOOGLE_CLIENT_SECRET="<your-google-oauth-client-secret>"

# 8. Google Drive OAuth 2.0 Refresh Token (Drive API delegation)
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN="<your-google-drive-oauth-refresh-token>"

# ------------------------------------------------------------------------------
# 3. OPTIONAL LOCAL OVERRIDES (Sensible built-in defaults exist)
# ------------------------------------------------------------------------------
# Default Gemini model (built-in default: gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-3.1-flash-lite"

# OAuth redirect callback URL (built-in default: http://localhost:3000/api/auth/google/callback)
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Optional bypass toggles for offline UI work
SKIP_DRIVE_SYNC="false"
SKIP_SHEETS_SYNC="false"
