# ==============================================================================
# BURRA PARIKSHA CMS (BP-CMS) — LOCAL ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# File: .env.local.example
# Purpose: Authoritative template for local development configuration in Antigravity.
#
# INSTRUCTIONS:
# 1. Copy this file to '.env.local' in the repository root.
# 2. Populate '.env.local' manually with your secrets and credentials from
#    Google AI Studio or Google Cloud Console.
#
# SECURITY RULES:
# - NEVER commit '.env.local' to GitHub (protected by .gitignore).
# - NEVER share or expose real secret keys, tokens, or passwords.
# - DO NOT add real credentials to this example template file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME NETWORKING & LOGGING
# ------------------------------------------------------------------------------
NODE_ENV="development"
PORT="3000"
HOST="0.0.0.0"
LOG_LEVEL="INFO"
DISABLE_HMR="false"

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying HMAC-SHA256 session tokens.
SESSION_SECRET="REPLACE_WITH_LOCAL_SESSION_SECRET"

# Initial password for default Administrator (USR-001) during first bootstrap.
INITIAL_ADMIN_PASSWORD="REPLACE_WITH_LOCAL_ADMIN_PASSWORD"

# Secret token required to authorize remote spreadsheet bootstrap endpoint (/api/sheets/initialize).
BOOTSTRAP_SECRET="REPLACE_WITH_LOCAL_BOOTSTRAP_SECRET"

# ------------------------------------------------------------------------------
# 3. GOOGLE SHEETS PRIMARY DATABASE
# ------------------------------------------------------------------------------
# Primary Google Sheets Spreadsheet ID representing the 25-tab datastore.
GOOGLE_SHEETS_ID="REPLACE_WITH_YOUR_GOOGLE_SHEETS_ID"

# Google Cloud Service Account email with Editor access on the Google Sheet.
GOOGLE_SERVICE_ACCOUNT_EMAIL="REPLACE_WITH_YOUR_SERVICE_ACCOUNT_EMAIL"

# Google Cloud Service Account RSA Private Key (PEM format).
GOOGLE_PRIVATE_KEY="REPLACE_WITH_YOUR_SERVICE_ACCOUNT_PRIVATE_KEY"

# Bypass live Google Sheets API sync (set to true for offline development/UI work).
SKIP_SHEETS_SYNC="false"

# ------------------------------------------------------------------------------
# 4. GOOGLE DRIVE MEDIA INFRASTRUCTURE
# ------------------------------------------------------------------------------
# Root folder ID in Google Drive where video takes and media assets are stored.
GOOGLE_DRIVE_ROOT_FOLDER_ID="REPLACE_WITH_YOUR_DRIVE_ROOT_FOLDER_ID"

# Google Cloud OAuth 2.0 Client ID for Drive user delegation.
GOOGLE_CLIENT_ID="REPLACE_WITH_YOUR_GOOGLE_CLIENT_ID"

# Google Cloud OAuth 2.0 Client Secret.
GOOGLE_CLIENT_SECRET="REPLACE_WITH_YOUR_GOOGLE_CLIENT_SECRET"

# Persistent Google Drive OAuth 2.0 Refresh Token obtained via user consent.
GOOGLE_DRIVE_OAUTH_REFRESH_TOKEN="REPLACE_WITH_YOUR_DRIVE_OAUTH_REFRESH_TOKEN"

# Google OAuth 2.0 redirect URI registered in Google Cloud Console.
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Bypass live Google Drive media sync (set to true for offline development).
SKIP_DRIVE_SYNC="false"

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (PRIMARY INTELLIGENCE PROVIDER)
# ------------------------------------------------------------------------------
# Google Gemini API key for assistive question ideation, script hooks, and auditing.
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"

# Default Gemini model identifier.
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 6. ISOLATED SOCIAL ANALYTICS WORKBOOK
# ------------------------------------------------------------------------------
# Dedicated Google Sheet ID for audience retention telemetry, comments, and analytics.
ANALYTICS_SPREADSHEET_ID="REPLACE_WITH_YOUR_ANALYTICS_SPREADSHEET_ID"

# ------------------------------------------------------------------------------
# 7. DISASTER RECOVERY & SNAPSHOT ARCHIVE (GCS)
# ------------------------------------------------------------------------------
# Google Cloud Storage bucket name for immutable snapshot backups.
GCS_SNAPSHOT_BUCKET="REPLACE_WITH_YOUR_GCS_SNAPSHOT_BUCKET"

# Toggle whether durable snapshot archiving to GCS is enabled.
GCS_SNAPSHOT_ENABLED="false"

# Retention duration in days for durable GCS snapshot archives.
GCS_SNAPSHOT_RETENTION_DAYS="365"

# Toggle whether automated periodic snapshot backups run in background.
GCS_SNAPSHOT_SCHEDULE_ENABLED="false"

# Interval in hours between scheduled snapshot backups.
GCS_SNAPSHOT_INTERVAL_HOURS="24"

# Toggle automatic retention cleanup of expired GCS archives.
GCS_SNAPSHOT_RETENTION_CLEANUP_ENABLED="false"

# Minimum number of newest durable snapshots protected from deletion.
GCS_SNAPSHOT_MIN_KEEP_COUNT="5"

# ------------------------------------------------------------------------------
# 8. GOOGLE CLOUD PLATFORM & FIRESTORE NATIVE (FC-003 / FC-004)
# ------------------------------------------------------------------------------
# Google Cloud Project ID (used by native Firestore adapter and audit dispatcher).
GCP_PROJECT_ID="burra-pariksha-cms"
GOOGLE_CLOUD_PROJECT="burra-pariksha-cms"

# Native Firestore database identifier ('(default)' unless configured otherwise).
FIRESTORE_DATABASE_ID="(default)"

# ------------------------------------------------------------------------------
# 9. MEDIA UPLOAD LIMITS
# ------------------------------------------------------------------------------
# Maximum thumbnail file upload size in bytes (default: 5242880 = 5 MB).
MAX_THUMBNAIL_SIZE_BYTES="5242880"

# Maximum video take file upload size in bytes (default: 104857600 = 100 MB).
MAX_VIDEO_SIZE_BYTES="104857600"

# ------------------------------------------------------------------------------
# 10. MULTI-PROVIDER AI CONFIGURATION (OPTIONAL / BROWNFIELD ADAPTERS)
# ------------------------------------------------------------------------------
AI_DEFAULT_PROVIDER="gemini"
AI_FALLBACK_PROVIDERS="groq,mistral"

# Optional third-party AI provider keys for fallback / multi-model experimentation:
GROQ_API_KEY=""
MISTRAL_API_KEY=""
CEREBRAS_API_KEY=""
COHERE_API_KEY=""
OPENROUTER_API_KEY=""
XAI_API_KEY=""
HUGGING_FACE_API_KEY=""
EXPERIMENTAL_LABS_API_KEY=""
EXPERIMENTAL_LABS_ENDPOINT_URL=""
