{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account profile with role matrix and session version",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 256 },
        "role": { "type": "string", "maxLength": 64 },
        "isActive": { "type": "boolean" },
        "sessionVersion": { "type": "number" },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "email", "name", "role", "version"]
    },
    "QuestionDraft": {
      "title": "QuestionDraft",
      "description": "Stage 01 question draft undergoing editorial review",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 256 },
        "title": { "type": "string", "maxLength": 512 },
        "category": { "type": "string", "maxLength": 128 },
        "difficulty": { "type": "string", "maxLength": 32 },
        "status": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "authorId", "title", "version"]
    },
    "Question": {
      "title": "Question",
      "description": "Stage 02 approved curriculum question",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "authorId": { "type": "string", "maxLength": 128 },
        "contentMasterId": { "type": "string", "maxLength": 128 },
        "question": { "type": "string", "maxLength": 4096 },
        "status": { "type": "string", "maxLength": 64 },
        "currentStage": { "type": "number" },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "version"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Task assignment across the 15 production stages",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "entityId": { "type": "string", "maxLength": 128 },
        "assigneeId": { "type": "string", "maxLength": 128 },
        "assigneeRole": { "type": "string", "maxLength": 64 },
        "stageNumber": { "type": "number" },
        "status": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "stageNumber", "status", "version"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Immutable append-only audit event log",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "actorId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 128 },
        "resourceType": { "type": "string", "maxLength": 128 },
        "resourceId": { "type": "string", "maxLength": 128 },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "action", "version"]
    },
    "ContentMaster": {
      "title": "ContentMaster",
      "description": "Master content lifecycle container",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "questionId": { "type": "string", "maxLength": 128 },
        "videoId": { "type": "string", "maxLength": 128 },
        "currentStage": { "type": "number" },
        "status": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "version"]
    },
    "Video": {
      "title": "Video",
      "description": "Video production metadata and takes",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "contentMasterId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "version"]
    },
    "PublishingPackage": {
      "title": "PublishingPackage",
      "description": "Multi-platform publishing package and sync state",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "videoId": { "type": "string", "maxLength": 128 },
        "contentMasterId": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "version"]
    },
    "SocialAnalytics": {
      "title": "SocialAnalytics",
      "description": "Social performance metrics and audience telemetry",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "contentId": { "type": "string", "maxLength": 128 },
        "platform": { "type": "string", "maxLength": 64 },
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "version"]
    },
    "WorkflowInstance": {
      "title": "WorkflowInstance",
      "description": "State machine workflow instance tracking current stage",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "entityId": { "type": "string", "maxLength": 128 },
        "currentStage": { "type": "number" },
        "status": { "type": "string", "maxLength": 64 },
        "version": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "isDeleted": { "type": "boolean" }
      },
      "required": ["id", "currentStage", "version"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User directory and role assignments"
    },
    "/question_drafts/{draftId}": {
      "schema": "QuestionDraft",
      "description": "Question drafting collection"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Curriculum questions"
    },
    "/assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Stage assignments and operational handoffs"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Immutable append-only audit ledger"
    },
    "/content_masters/{contentMasterId}": {
      "schema": "ContentMaster",
      "description": "Content master records"
    },
    "/videos/{videoId}": {
      "schema": "Video",
      "description": "Video production tracking"
    },
    "/publishing_packages/{packageId}": {
      "schema": "PublishingPackage",
      "description": "Publishing and distribution records"
    },
    "/social_analytics/{analyticsId}": {
      "schema": "SocialAnalytics",
      "description": "Social performance analytics"
    },
    "/workflow_instances/{workflowId}": {
      "schema": "WorkflowInstance",
      "description": "Canonical 15-step workflow state machine records"
    }
  }
}
